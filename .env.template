# Refer to https://docs.datarobot.com/en/docs/api/api-quickstart/index.html#create-a-datarobot-api-key
# and https://docs.datarobot.com/en/docs/api/api-quickstart/index.html#retrieve-the-api-endpoint
# Can be deleted on a DataRobot codespace
# DATAROBOT_API_TOKEN=
# DATAROBOT_ENDPOINT=

# Required, unless logged in to pulumi cloud. Choose your own alphanumeric passphrase to be used for encrypting pulumi config
PULUMI_CONFIG_PASSPHRASE=1234abc

# Required for FastAPI session cookies and Pulumi deployments.
# `dr dotenv setup` generates this automatically; for manual setup, use a long random string.
# SESSION_SECRET_KEY=<long_random_string>

# If empty, a new use case will be created
DATAROBOT_DEFAULT_USE_CASE=
# Optional: OpenTelemetry tracing.
# These values are passed as app runtime parameters when set.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
#
# Set to true to disable telemetry:
# OTEL_SDK_DISABLED=true

# By setting to 'true', user of the app will use the app builder's token, so will be able to access all the assets
# of the app builder.
USE_BUILDER_API_TOKEN=false

# Optional: Choose if disable all resource related to usage dashboard
# DISALLOW_MONITORING_RESOURCES=false

# Optional: Choose if disallow cleanup job for custom application
# DISALLOW_APP_CLEANUP_JOB=true

# LLM Configuration:
# Talk to My Data supports multiple flexible LLM options:
# - Already deployed DataRobot text generation model (default)
# - LLM Gateway direct
# - LLM Blueprint with LLM Gateway
# - LLM Blueprint with an external LLM
# - Registered model deployed through an LLM Blueprint
#
# Choose one configuration module from infra/configurations/llm.
# The default deployed_llm.py option requires TEXTGEN_DEPLOYMENT_ID below.
# INFRA_ENABLE_LLM=deployed_llm.py

# If you want to use DataRobot LLM Gateway directly:
# INFRA_ENABLE_LLM=gateway_direct.py
# USE_DATAROBOT_LLM_GATEWAY=true
# LLM_DEFAULT_MODEL=datarobot/bedrock/anthropic.claude-sonnet-4-5-20250929-v1:0

# If you want to use an LLM Blueprint backed by LLM Gateway:
# INFRA_ENABLE_LLM=blueprint_with_llm_gateway.py
# USE_DATAROBOT_LLM_GATEWAY=true
# LLM_DEFAULT_MODEL=datarobot/bedrock/anthropic.claude-sonnet-4-5-20250929-v1:0

# If you want to use an existing DataRobot text generation deployment:
# INFRA_ENABLE_LLM=deployed_llm.py
# TEXTGEN_DEPLOYMENT_ID=<your_deployment_id>
# LLM_DEFAULT_MODEL=datarobot/datarobot-deployed-llm

# If you want to deploy an existing registered text generation model:
# INFRA_ENABLE_LLM=registered_model.py
# TEXTGEN_REGISTERED_MODEL_ID=<your_registered_model_id>
# DATAROBOT_TIMEOUT_MINUTES=120
# LLM_DEFAULT_MODEL=datarobot/datarobot-deployed-llm

# If you want to configure an LLM Blueprint with external provider credentials:
# INFRA_ENABLE_LLM=blueprint_with_external_llm.py
# LLM_DEFAULT_MODEL=azure/gpt-4o
# LLM_DEFAULT_LLM_ID=azure-openai-gpt-4-o
# LLM_DEFAULT_LLM_NAME=Azure OpenAI GPT-4o
# OPENAI_API_VERSION=2024-08-01-preview
# OPENAI_API_BASE=https://<your_custom_endpoint>.openai.azure.com
# OPENAI_API_DEPLOYMENT_ID=<your_deployment_id>
# OPENAI_API_KEY=<your_api_key>

# APP ENVIRONMENT SETTINGS
#
# By default, Pulumi creates and manages the app ExecutionEnvironment from docker/Dockerfile.
# If you already have an ExecutionEnvironment for the app, set these IDs here to opt out.

# Optional: use an existing pre-built DataRobot execution environment and version for the app backend.
# APPLICATION_EXECUTION_ENVIRONMENT_ID=
# APPLICATION_EXECUTION_ENVIRONMENT_VERSION_ID=

# Use LLM Gateway instead of DataRobot-hosted LLM.
USE_DATAROBOT_LLM_GATEWAY=

# To use an existing TextGen Model or Deployment:
#  1. Provide exactly one of: registered model ID, or deployment ID 
#  2. Set CHAT_MODEL_NAME to the model name expected by the TextGen model (e.g. gpt-4o-mini)
#  3. Set LLM=LLMs.DEPLOYED_LLM in infra/settings_generative.py

# TEXTGEN_REGISTERED_MODEL_ID=
# TEXTGEN_DEPLOYMENT_ID=
# CHAT_MODEL_NAME=datarobot-deployed-llm # for NIM models, "datarobot-deployed-llm" will automatically be translated to the correct model name.

# Set up DataRobot-hosted LLM deployment (make sure to comment and unset OPENAI_* variables if you want to use DataRobot LLM Gateway)
# For Azure OpenAI:
# Refer to (https://learn.microsoft.com/en-us/azure/ai-services/openai/chatgpt-quickstart?tabs=command-line%2Cjavascript-keyless%2Ctypescript-keyless%2Cpython-new&pivots=programming-language-python#retrieve-key-and-endpoint)

# OPENAI_API_KEY=
# OPENAI_API_BASE=
# OPENAI_API_VERSION=
# OPENAI_API_DEPLOYMENT_ID=


# For Google VertexAI

# You will need a service account JSON with aiplatform.endpoints.predict permission (https://cloud.google.com/iam/docs/keys-create-delete)
# Add the JSON file content enclosed by '' here:

# GOOGLE_SERVICE_ACCOUNT=
# GOOGLE_REGION=

# For AWS Bedrock:

# Refer to https://docs.aws.amazon.com/IAM/latest/UserGuide/id_credentials_access-keys.html
# AWS_SESSION_TOKEN is optional in case you are using a long term access key

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=


# =========Database ========== #

# To use a database, set DATABASE_CONNECTION_TYPE=datarobot_jdbc.
# The dialect is detected automatically from the JDBC_URI prefix.
# DATABASE_CONNECTION_TYPE=datarobot_jdbc
# DATABASE_DESCRIPTION_PATH=
#
# JDBC_URI is the full JDBC connection string. Credentials may be embedded in the URI
# or passed separately via JDBC_CONNECTION_PARAMETERS — the JDBC spec allows either.
#   jdbc:postgresql://   — PostgreSQL
#   jdbc:mysql://        — MySQL
#   jdbc:sqlserver://    — SQL Server
#   jdbc:snowflake://    — Snowflake
#   jdbc:sap://          — SAP Datasphere (HANA)
#   jdbc:bigquery://     — BigQuery
#
# JDBC_URI=jdbc:postgresql://localhost:5432/mydb
# JDBC_URI=jdbc:snowflake://<account_identifier>.snowflakecomputing.com/?warehouse=COMPUTE_WH&db=SNOWFLAKE_SAMPLE_DATA&schema=TPCH_SF1&role=PUBLIC
# JDBC_URI=jdbc:sap://host:443
# JDBC_URI=jdbc:bigquery://https://www.googleapis.com/bigquery/v2:443
#
# JDBC_CONNECTION_PARAMETERS is optional. The value must be valid JSON.
# JDBC_CONNECTION_PARAMETERS='{"user": "dbuser", "password": "secret"}'
# Snowflake JDBC examples:
# JDBC_CONNECTION_PARAMETERS='{"user": "snowflake_user", "password": "snowflake_password"}'
# JDBC_CONNECTION_PARAMETERS='{"user": "snowflake_user", "private_key_file": "rsa_key.p8"}'
#
# Legacy Snowflake variables kept for local compatibility paths.
# DATABASE_CONNECTION_TYPE=snowflake
#
# Choose which authentication method to use for Snowflake.
# snowflake_authentication="key file authentication"
#
# SNOWFLAKE_USER="<snowflake_user>"
# SNOWFLAKE_PASSWORD="<snowflake_password>"
# The Snowflake key path
# SNOWFLAKE_KEY_PATH="rsa_key.p8"
#
# The Snowflake account
# SNOWFLAKE_ACCOUNT="<account_identifier>"
#
# The Snowflake warehouse
# SNOWFLAKE_WAREHOUSE="COMPUTE_WH"
#
# The Snowflake database
# SNOWFLAKE_DATABASE="SNOWFLAKE_SAMPLE_DATA"
#
# The Snowflake schema
# SNOWFLAKE_SCHEMA="TPCH_SF1"
#
# The Snowflake role
# SNOWFLAKE_ROLE="PUBLIC"

# Frontend Feature Flags

# Enable/disable template edit functionality in the frontend (default: true)
VITE_ENABLE_TEMPLATE_EDIT=False
# Enable/disable custom prompts functionality in the frontend (default: false)
VITE_ENABLE_CUSTOM_PROMPTS=False

# Enable/disable question refiner functionality in the frontend (default: false)
VITE_ENABLE_QUESTION_REFINER=False
# Enable/disable auto-send after refining questions (default: true)
# If true, refined questions are automatically sent to chat
# If false, user needs to click send button after refining
VITE_ENABLE_REFINER_AUTO_SEND=True

# Enable/disable report builder functionality (default: false)
# Allows users to create Word document reports from multiple chat queries
VITE_ENABLE_REPORT_BUILDER=False

# Path to the custom prompts template CSV file
# If you want to enable custom prompts feature, please provide the path to your custom prompts template CSV file here:
# PROMPTS_TEMPLATE_PATH=(e.g. assets/prompt_templates.csv)
